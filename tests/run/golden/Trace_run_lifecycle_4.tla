---- MODULE Trace_run_lifecycle_4 ----
\* Generated by refinery.run.trace_export from the event log of run
\* run-lifecycle.4. Do not edit. TLC accepts the log as a behaviour of Run
\* iff it reports TraceIncomplete violated.
EXTENDS Run

TheRun == CHOOSE r \in Runs : TRUE
TheChange == CHOOSE c \in Changes : TRUE

Trace == <<
    [act |-> "StartRun", from |-> "none", to |-> "spec"],
    [act |-> "CompleteSpec", from |-> "spec", to |-> "model"],
    [act |-> "CompleteModel", from |-> "model", to |-> "spec_review"],
    [act |-> "ApproveSpec", from |-> "spec_review", to |-> "tests"],
    [act |-> "CompleteTests", from |-> "tests", to |-> "tests_review"],
    [act |-> "ApproveTests", from |-> "tests_review", to |-> "impl"],
    [act |-> "CompleteImpl", from |-> "impl", to |-> "verify"],
    [act |-> "PassGate", from |-> "verify", to |-> "final_review"],
    [act |-> "ApproveFinal", from |-> "final_review", to |-> "archive"],
    [act |-> "RetryArchive", from |-> "archive", to |-> "archive"],
    [act |-> "Archive", from |-> "archive", to |-> "archived"]
>>

VARIABLE i  \* trace events consumed so far

TraceInit == Init /\ i = 0

Step(act) ==
    CASE act = "StartRun" -> StartRun(TheRun, TheChange)
      [] act = "CompleteSpec" -> CompleteSpec(TheRun)
      [] act = "CompleteModel" -> CompleteModel(TheRun)
      [] act = "SkipModel" -> SkipModel(TheRun)
      [] act = "ApproveSpec" -> ApproveSpec(TheRun)
      [] act = "RejectSpec" -> RejectSpec(TheRun)
      [] act = "CompleteTests" -> CompleteTests(TheRun)
      [] act = "ApproveTests" -> ApproveTests(TheRun)
      [] act = "RejectTests" -> RejectTests(TheRun)
      [] act = "CompleteImpl" -> CompleteImpl(TheRun)
      [] act = "PassGate" -> PassGate(TheRun)
      [] act = "FailGate" -> FailGate(TheRun)
      [] act = "Escalate" -> Escalate(TheRun)
      [] act = "ResolveToSpec" -> ResolveToSpec(TheRun)
      [] act = "ResolveToTests" -> ResolveToTests(TheRun)
      [] act = "ResolveToImpl" -> ResolveToImpl(TheRun)
      [] act = "ApproveFinal" -> ApproveFinal(TheRun)
      [] act = "RejectFinal" -> RejectFinal(TheRun)
      [] act = "Archive" -> Archive(TheRun)
      [] act = "RetryArchive" -> RetryArchive(TheRun)
      [] act = "Cancel" -> Cancel(TheRun)

\* An Archive attempt is in flight but was never logged: its validation
\* failed and the event was withdrawn.
Withdrawn == Len(log[TheRun]) > i

\* Event i+1 is begun by its action and must match the logged event; then
\* CommitRecord finishes it (Archive first needs a passing CheckTrace).
\* A withdrawn Archive attempt is replayed only where the log shows one,
\* right before RetryArchive, and must end in AbortArchive. Each choice is
\* forced, so TLC's verdict does not depend on search order.
TraceNext ==
    \/ /\ i < Len(Trace)
       /\ Step(Trace[i + 1].act)
       /\ log'[TheRun][Len(log'[TheRun])] = Trace[i + 1]
       /\ i' = i + 1
    \/ /\ i < Len(Trace)
       /\ Trace[i + 1].act = "RetryArchive"
       /\ Archive(TheRun)
       /\ UNCHANGED i
    \/ /\ CheckTrace(TheRun)
       /\ pending'[TheRun][1].verdict = IF Withdrawn THEN "fail" ELSE "pass"
       /\ UNCHANGED i
    \/ AbortArchive(TheRun) /\ UNCHANGED i
    \/ CommitRecord(TheRun) /\ ~Withdrawn /\ UNCHANGED i

\* Accepted: every event consumed, nothing in flight, and the run is where
\* the last event left it.
TraceIncomplete ==
    ~(/\ i = Len(Trace)
      /\ pending[TheRun] = <<>>
      /\ log[TheRun] = Trace
      /\ phase[TheRun] = Trace[Len(Trace)].to)
========
